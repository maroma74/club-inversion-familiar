generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Family {
  id               String       @id @default(cuid())
  name             String
  inviteCode       String       @unique
  /// Cómo se entra con el código general: CODE (directo), CODE_APPROVAL (queda pendiente de aprobación), INVITE_ONLY (solo con invitación personal)
  joinMode         String       @default("CODE")
  monthlyAllowance Float        @default(100)
  createdAt        DateTime     @default(now())
  users            User[]
  invitations      Invitation[]
  manualPrices     ManualPrice[]
  proposals        Proposal[]
  communications   Communication[]
}

model User {
  id            String         @id @default(cuid())
  familyId      String
  family        Family         @relation(fields: [familyId], references: [id])
  name          String
  email         String         @unique
  passwordHash  String
  role          String         @default("MEMBER") // ADMIN | MEMBER
  status        String         @default("ACTIVE") // ACTIVE | PENDING (esperando aprobación)
  badgeCount    Int            @default(0) // logros conseguidos (se actualiza al calcular la liga)
  createdAt     DateTime       @default(now())
  contributions Contribution[]
  trades        Trade[]
  snapshots     PortfolioSnapshot[]
  invitationsSent Invitation[] @relation("InvitationCreator")
  invitationUsed  Invitation?  @relation("InvitationUser")
  lessonProgress  LessonProgress[]
  journalEntries  JournalEntry[]
  monthlyAllocations MonthlyAllocation[]
  monthlyDecisions   MonthlyDecision[]
  /// Cuándo se subió la foto de perfil (null = sin foto). Sirve para cachear la imagen con ?v=.
  avatarUpdatedAt    DateTime?
  avatar             UserAvatar?
  /// Teléfono móvil en formato internacional (+34…) para recibir avisos por WhatsApp; lo pone cada uno en su perfil.
  phone              String?
  communicationsSent Communication[]
  /// Sube al cambiar o restablecer la contraseña: las sesiones firmadas con un valor anterior dejan de valer.
  sessionVersion     Int            @default(0)
  passwordResets     PasswordReset[] @relation("PasswordResetUser")
  passwordResetsIssued PasswordReset[] @relation("PasswordResetIssuer")

  @@index([familyId, status])
}

/// Enlace de un solo uso, emitido por el presidente, para que un miembro fije una contraseña nueva.
/// Solo se guarda el hash del token; el enlace completo se enseña una vez y se envía por correo.
model PasswordReset {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("PasswordResetUser", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String
  createdBy   User      @relation("PasswordResetIssuer", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Foto de perfil (cuadrada, ya reducida en el navegador). Va en tabla aparte para no cargar los bytes en cada consulta de usuario.
model UserAvatar {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  mime      String
  updatedAt DateTime @default(now())
}

/// Invitación personal al club: un código de un solo uso, opcionalmente ligado a un nombre y un email, con caducidad.
model Invitation {
  id          String    @id @default(cuid())
  familyId    String
  family      Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  code        String    @unique
  name        String?
  email       String?
  role        String    @default("MEMBER") // rol que tendrá al entrar
  note        String?
  expiresAt   DateTime?
  createdById String
  createdBy   User      @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  usedAt      DateTime?
  usedById    String?   @unique
  usedBy      User?     @relation("InvitationUser", fields: [usedById], references: [id], onDelete: SetNull)
  revokedAt   DateTime?
  sentAt      DateTime? // último envío por correo
  sentTo      String?   // dirección a la que se envió
  /// Invitación para crear una familia nueva: quien la usa funda su club y es su presidente.
  newFamily   Boolean   @default(false)

  @@index([familyId, createdAt])
}

model Contribution {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  amount    Float
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Trade {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  symbol    String
  name      String
  side      String // BUY | SELL
  quantity  Float
  price     Float // precio por unidad en `currency`
  currency  String   @default("EUR")
  fxRate    Float    @default(1) // euros por unidad de `currency` en la fecha de la operación
  fees      Float    @default(0) // siempre en EUR
  broker    String? // entidad donde se ejecutó la orden (Trade Republic, Degiro, Binance…)
  createdAt DateTime @default(now())
  journal   JournalEntry?

  @@index([userId, date])
}

model PriceQuote {
  symbol    String   @id
  name      String
  price     Float
  currency  String   @default("EUR")
  updatedAt DateTime @default(now())
}

/// Precio fijado a mano por el presidente para un valor sin cotización automática. Solo afecta a su familia.
model ManualPrice {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  symbol    String
  name      String
  price     Float // en euros
  updatedAt DateTime @default(now())

  @@unique([familyId, symbol])
}

/// Intentos de login/registro por clave (ip, email) para limitar la fuerza bruta.
model AuthAttempt {
  id  String   @id @default(cuid())
  key String
  at  DateTime @default(now())

  @@index([key, at])
}

/// Caché diaria de los resultados trimestrales (BPA) de una acción y del resumen de su PER histórico.
/// Los trimestrales cambian poco: se refresca como mucho una vez al día, nunca en cada carga de página.
model EpsCache {
  symbol    String   @id
  provider  String // sec-edgar | yahoo-fundamentals
  status    String // OK | UNAVAILABLE (el proveedor funciona pero no tiene el valor)
  reason    String?
  quarters  Json // QuarterEps[] ya ajustados por splits (SEC)
  /// Serie de BPA de los últimos 12 meses ya construida (proveedores que no dan trimestres, como Yahoo)
  ttm       Json?
  /// Divisa del BPA (USD, EUR, GBP…) para compararlo con el precio
  currency  String?
  summary   Json? // PerSummary del rango por defecto (para el listado y la recomendación)
  fetchedAt DateTime
}

model PortfolioSnapshot {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date     DateTime
  value    Float
  invested Float

  @@unique([userId, date])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  familyId  String
  symbol    String
  name      String
  kind      String   @default("STOCK") // STOCK | ETF
  createdAt DateTime @default(now())

  @@unique([familyId, symbol])
}

/// Recomendación del Club de inversión: una foto diaria por símbolo para ver cambios de opinión en el tiempo.
model ClubRecommendation {
  id         String   @id @default(cuid())
  symbol     String
  date       DateTime
  action     String // COMPRAR | MANTENER | VENDER
  bias       String
  score      Float
  confidence String
  rr         Float?
  createdAt  DateTime @default(now())

  @@unique([symbol, date])
  @@index([symbol, date])
}

/// Academia: cursos por nivel, lecciones con quiz y progreso por miembro.
model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  level       Int      @unique // 1..6, coincide con los niveles de la liga
  title       String
  description String
  lessons     Lesson[]
}

model Lesson {
  id        String           @id @default(cuid())
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slug      String
  order     Int
  title     String
  minutes   Int              @default(6)
  body      Json // { intro: string[], keyIdea: string, table?: {headers, rows, caption}, outro: string[], apply: string }
  questions QuizQuestion[]
  progress  LessonProgress[]

  @@unique([courseId, slug])
  @@unique([courseId, order])
}

model QuizQuestion {
  id           String @id @default(cuid())
  lessonId     String
  lesson       Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order        Int
  text         String
  options      Json // string[]
  correctIndex Int
  feedback     String
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  score       Int       @default(0) // aciertos del último intento
  attempts    Int       @default(0)
  completedAt DateTime? // null hasta superar la lección (todas correctas)
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
}

/// Diario de inversión: el porqué de cada decisión, opcionalmente ligado a una operación.
model JournalEntry {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeId       String?  @unique
  trade         Trade?   @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  symbol        String
  side          String // BUY | SELL | NOTE
  why           String
  exitCondition String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

/// Cartera mensual: el presidente decide cuánto recibe cada miembro y entre qué valores pueden elegir; los miembros investigan, argumentan y deciden.
/// Repositorio de propuestas de cartera: plantillas con texto neutro (sin meses ni periodos) que cualquier presidente
/// puede usar para crear la cartera de un mes. Las hay del club (semilla, source CLUB) y compartidas por presidentes
/// (source FAMILY), firmadas con el nombre de su familia o anónimas.
model Proposal {
  id                String           @id @default(cuid())
  slug              String?          @unique // identificador estable de las propuestas del club
  source            String // CLUB | FAMILY
  familyId          String? // familia autora; nunca se expone si la propuesta es anónima
  family            Family?          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  signed            Boolean          @default(false) // true: se muestra «Familia X»; false: anónima
  sourcePortfolioId String?          @unique // cartera de la que se copió (solo FAMILY): permite actualizar o retirar
  title             String
  theme             String // categoría (Núcleo global, Dividendos, Tecnología…)
  risk              Int // 1 (bajo) a 5 (muy alto)
  lesson            String // texto de la lección, en neutro
  minChoices        Int              @default(1)
  maxChoices        Int              @default(1)
  uses              Int              @default(0) // veces que se ha usado para crear una cartera
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  options           ProposalOption[]
  /// Carteras creadas a partir de esta propuesta
  portfolios MonthlyPortfolio[]

  @@index([source, theme])
}

model ProposalOption {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  symbol     String
  name       String
  kind       String   @default("STOCK") // STOCK | ETF | CRYPTO | COMMODITY
  note       String? // qué investigar
  order      Int      @default(0)

  @@unique([proposalId, symbol])
}

model MonthlyPortfolio {
  id          String   @id @default(cuid())
  familyId    String
  month       String // YYYY-MM
  title       String
  lesson      String // explicación / lección del mes (texto, párrafos separados por líneas en blanco)
  status      String   @default("DRAFT") // DRAFT | PUBLISHED | CLOSED
  minChoices  Int      @default(1)
  maxChoices  Int      @default(1)
  deadline    DateTime?
  createdById String
  createdAt   DateTime @default(now())
  publishedAt DateTime?
  closedAt    DateTime?
  /// Propuesta del repositorio de la que se creó (para marcarla como usada por la familia)
  sourceProposalId String?
  sourceProposal   Proposal? @relation(fields: [sourceProposalId], references: [id], onDelete: SetNull)
  options     MonthlyOption[]
  allocations MonthlyAllocation[]
  decisions   MonthlyDecision[]

  @@unique([familyId, month])
  @@index([sourceProposalId])
}

model MonthlyOption {
  id          String   @id @default(cuid())
  portfolioId String
  portfolio   MonthlyPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  symbol      String
  name        String
  kind        String   @default("STOCK") // STOCK | ETF | CRYPTO
  note        String? // qué investigar / por qué está en la lista
  order       Int      @default(0)
  choices     MonthlyChoice[]

  @@unique([portfolioId, symbol])
}

/// Cantidad asignada por el presidente a cada miembro para ese mes (se convierte en aportación al publicar).
model MonthlyAllocation {
  id             String   @id @default(cuid())
  portfolioId    String
  portfolio      MonthlyPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Float
  contributionId String?  @unique

  @@unique([portfolioId, userId])
}

model MonthlyDecision {
  id          String   @id @default(cuid())
  portfolioId String
  portfolio   MonthlyPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  argument    String // razonamiento general
  submittedAt DateTime @default(now())
  choices     MonthlyChoice[]

  @@unique([portfolioId, userId])
}

model MonthlyChoice {
  id             String   @id @default(cuid())
  decisionId     String
  decision       MonthlyDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  optionId       String
  option         MonthlyOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  amount         Float
  why            String
  exitCondition  String?
  tradeId        String?
  journalEntryId String?
  price          Float? // precio de ejecución en EUR
  quantity       Float?

  @@index([tradeId])
  @@index([journalEntryId])
}

/// Respuestas de proveedores externos (BCE, FRED, Finnhub) guardadas con su fecha: sobreviven a los arranques
/// en frío de Cloud Run y evitan repetir llamadas (cada módulo decide cuánto tiempo valen).
model ApiCache {
  key       String   @id
  data      Json
  fetchedAt DateTime
}

/// Comunicación del presidente a los miembros (hoy, por WhatsApp con «clic para chatear»). Se guarda el texto
/// enviado y, por destinatario, el mensaje personalizado y cuándo se abrió WhatsApp para enviárselo.
model Communication {
  id          String   @id @default(cuid())
  familyId    String
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  channel     String   @default("WHATSAPP")
  kind        String   @default("PORTFOLIO") // PORTFOLIO (cartera del mes lista) | FREE (texto libre)
  portfolioId String? // cartera a la que se refiere
  subject     String
  body        String // plantilla con los marcadores ya documentados
  recipients  Json // [{ userId, name, phone, text, openedAt }]
  createdAt   DateTime @default(now())

  @@index([familyId, createdAt])
}
