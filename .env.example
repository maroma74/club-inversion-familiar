# Copia este archivo a .env y ajusta los valores.
# Desarrollo local: `npx prisma dev -n clubinversion -d` arranca un PostgreSQL local (sin Docker) y muestra su URL TCP.
# Añade connection_limit=1&pgbouncer=true: el servidor de prisma dev comparte una sola sesión y sin esto Prisma falla con "prepared statement s0 already exists".
DATABASE_URL="postgres://postgres:postgres@localhost:51219/template1?sslmode=disable&connection_limit=1&pgbouncer=true"
# Producción (Cloud SQL por socket): postgresql://USUARIO:CLAVE@localhost/clubinversion?host=/cloudsql/PROYECTO:REGION:INSTANCIA
# Clave larga y aleatoria para firmar las sesiones: genera una con `openssl rand -base64 48` (en producción
# la app rechaza valores cortos o de ejemplo y no arranca sin ella).
AUTH_SECRET=""

# Correo (invitaciones) con Resend: https://resend.com. Sin clave, en desarrollo el correo se imprime en la consola.
RESEND_API_KEY=""
# Remitente: debe ser de un dominio verificado en Resend.
EMAIL_FROM="Club de Inversión Familiar <club@clubdeinversionfamiliar.com>"

# URL pública (enlaces de invitación). En desarrollo no hace falta.
APP_URL=""
# Solo con "true" se pueden crear familias nuevas desde el registro. Por defecto el club está cerrado
# (se entra con código o invitación); en desarrollo se abre para crear la primera familia.
ALLOW_FAMILY_SIGNUP="true"

# PER histórico: la SEC exige un User-Agent con un contacto real (nombre de la app y un correo que leas).
SEC_USER_AGENT="ClubInversionFamiliar/1.0 (club@clubdeinversionfamiliar.com)"
# Peso del bloque «Valoración (PER)» en la recomendación (0 a 0,4; 0 lo desactiva). Por defecto 0,15.
PER_WEIGHT="0.15"

# Finnhub (https://finnhub.io, cuenta gratuita: 60 peticiones/min): consenso de analistas, sorpresas de resultados y
# próxima fecha de resultados en la ficha de cada acción. Sin clave, ese panel no se muestra.
FINNHUB_API_KEY=""
# FRED (https://fred.stlouisfed.org/docs/api/api_key.html, gratuita): tipos e inflación de EE. UU. en «Contexto del mercado».
# Los datos del BCE (tipos, Euríbor e inflación de la zona euro y España) no necesitan clave.
FRED_API_KEY=""
